[
  {
    "name": "theme_info",
    "theme_name": "Megan Restaurant",
    "theme_version": "1.0.0",
    "theme_author": "Megan The Restaurant",
    "theme_documentation_url": "https://megantherestaurant.com",
    "theme_support_url": "https://megantherestaurant.com"
  },
  {
    "name": "Branding",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo" },
      { "type": "range", "id": "logo_width", "label": "Logo width (px)", "min": 80, "max": 300, "step": 10, "default": 160 },
      { "type": "text", "id": "restaurant_name", "label": "Restaurant name", "default": "Megan The Restaurant" }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      { "type": "color", "id": "color_bg",        "label": "Background",     "default": "#0C0C0C" },
      { "type": "color", "id": "color_surface",   "label": "Surface",        "default": "#111111" },
      { "type": "color", "id": "color_surface_2", "label": "Surface 2",      "default": "#161616" },
      { "type": "color", "id": "color_text",      "label": "Text",           "default": "#E5E5E5" },
      { "type": "color", "id": "color_muted",     "label": "Muted text",     "default": "#888888" },
      { "type": "color", "id": "color_accent",    "label": "Accent (gold)",  "default": "#C5A880" },
      { "type": "color", "id": "color_accent_dk", "label": "Accent dark",    "default": "#A8845A" }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      { "type": "font_picker", "id": "font_heading", "label": "Heading font", "default": "playfair_display_n4" },
      { "type": "font_picker", "id": "font_body", "label": "Body font", "default": "lato_n4" }
    ]
  },
  {
    "name": "Contact",
    "settings": [
      { "type": "text", "id": "address_line1", "label": "Address line 1", "default": "1163 Central A" },
      { "type": "text", "id": "address_line2", "label": "Address line 2", "default": "Johnston, Rhode Island 02919" },
      { "type": "text", "id": "address_country", "label": "Country", "default": "USA" },
      { "type": "text", "id": "phone", "label": "Phone", "default": "[RESTAURANT PHONE]" },
      { "type": "text", "id": "email", "label": "Email", "default": "[RESTAURANT EMAIL]" },
      { "type": "text", "id": "map_url", "label": "Google Maps embed URL", "info": "Paste your Google Maps embed URL here" }
    ]
  },
  {
    "name": "Opening Hours",
    "settings": [
      { "type": "text", "id": "hours_monday", "label": "Monday", "default": "Closed" },
      { "type": "text", "id": "hours_tuesday", "label": "Tuesday", "default": "5:00 PM – 10:00 PM" },
      { "type": "text", "id": "hours_wednesday", "label": "Wednesday", "default": "5:00 PM – 10:00 PM" },
      { "type": "text", "id": "hours_thursday", "label": "Thursday", "default": "5:00 PM – 10:00 PM" },
      { "type": "text", "id": "hours_friday", "label": "Friday", "default": "5:00 PM – 11:00 PM" },
      { "type": "text", "id": "hours_saturday", "label": "Saturday", "default": "5:00 PM – 11:00 PM" },
      { "type": "text", "id": "hours_sunday", "label": "Sunday", "default": "Closed" },
      { "type": "text", "id": "hours_notice", "label": "Special hours notice", "info": "e.g. Closed on public holidays" }
    ]
  },
  {
    "name": "Social Media",
    "settings": [
      { "type": "url", "id": "social_instagram", "label": "Instagram URL" },
      { "type": "url", "id": "social_facebook", "label": "Facebook URL" },
      { "type": "url", "id": "social_tiktok", "label": "TikTok URL" },
      { "type": "url", "id": "social_twitter", "label": "X / Twitter URL" }
    ]
  },
  {
    "name": "Reservation",
    "settings": [
      { "type": "url", "id": "reservation_url", "label": "Reservation URL", "info": "Link to your booking platform (OpenTable, Resy, etc.)" },
      { "type": "text", "id": "reservation_embed", "label": "Reservation embed code", "info": "Paste embed code from your booking provider" },
      { "type": "text", "id": "reservation_btn_text", "label": "Reservation button text", "default": "Book a Table" }
    ]
  },
  {
    "name": "Menu PDF",
    "settings": [
      { "type": "url", "id": "menu_pdf_url", "label": "Menu PDF URL", "info": "Upload PDF to Shopify Files and paste URL here" },
      { "type": "text", "id": "menu_pdf_label", "label": "Download button label", "default": "Download Menu PDF" }
    ]
  },
  {
    "name": "General",
    "settings": [
      { "type": "checkbox", "id": "enable_animations", "label": "Enable scroll animations", "default": true },
      { "type": "text", "id": "footer_copyright", "label": "Footer copyright text", "default": "© Megan The Restaurant. All Rights Reserved." }
    ]
  }
]
