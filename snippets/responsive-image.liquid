{% comment %}
  Responsive image snippet
  Usage: {% render 'responsive-image', image: image, widths: '400,800,1200', sizes: '(max-width:768px) 100vw, 50vw', class: 'my-class', loading: 'lazy' %}
{% endcomment %}

{%- if image != blank -%}
  {%- assign loading_attr = loading | default: 'lazy' -%}
  {%- assign widths_list = widths | default: '400,800,1200,1600' | split: ',' -%}
  {%- assign sizes_attr = sizes | default: '100vw' -%}

  <img
    src="{{ image | image_url: width: 800 }}"
    srcset="{%- for w in widths_list -%}{{ image | image_url: width: w }} {{ w }}w{%- unless forloop.last -%}, {%- endunless -%}{%- endfor -%}"
    sizes="{{ sizes_attr }}"
    alt="{{ image.alt | default: alt | default: '' | escape }}"
    width="{{ image.width }}"
    height="{{ image.height }}"
    loading="{{ loading_attr }}"
    {% if class %}class="{{ class }}"{% endif %}
  >
{%- endif -%}
