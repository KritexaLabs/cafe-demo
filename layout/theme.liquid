<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#0e0c0a">

  {%- if page_description -%}
    <meta name="description" content="{{ page_description | escape }}">
  {%- endif -%}

  <!-- Open Graph -->
  <meta property="og:site_name" content="{{ shop.name }}">
  <meta property="og:url" content="{{ canonical_url }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:type" content="website">
  {%- if page_image -%}
    <meta property="og:image" content="{{ page_image | image_url: width: 1200 }}">
  {%- endif -%}
  {%- if page_description -%}
    <meta property="og:description" content="{{ page_description | escape }}">
  {%- endif -%}

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="{{ page_title | escape }}">
  {%- if page_description -%}
    <meta name="twitter:description" content="{{ page_description | escape }}">
  {%- endif -%}

  <title>{{ page_title }}{% unless page_title contains shop.name %} — {{ shop.name }}{% endunless %}</title>

  <link rel="canonical" href="{{ canonical_url }}">

  <!-- Fonts preconnect -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

  {{ content_for_header }}

  <!-- Styles -->
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'responsive.css' | asset_url | stylesheet_tag }}
  {{ 'component-lightbox.css' | asset_url | stylesheet_tag }}

  <!-- CSS Variables from Theme Settings -->
  <style>
    :root {
      --color-bg: {{ settings.color_bg }};
      --color-surface: {{ settings.color_surface }};
      --color-text: {{ settings.color_text }};
      --color-muted: {{ settings.color_muted }};
      --color-accent: {{ settings.color_accent }};
      --color-border: {{ settings.color_border }}33;
    }
  </style>

  <!-- JSON-LD: Restaurant -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Restaurant",
    "name": {{ settings.restaurant_name | json }},
    "url": {{ shop.url | json }},
    "address": {
      "@type": "PostalAddress",
      "streetAddress": {{ settings.address_line1 | json }},
      "addressLocality": "Johnston",
      "addressRegion": "RI",
      "postalCode": "02919",
      "addressCountry": "US"
    },
    "telephone": {{ settings.phone | json }},
    "email": {{ settings.email | json }},
    "servesCuisine": "American",
    "priceRange": "$$$$"
  }
  </script>
</head>

<body class="template-{{ template.name }}{% if template.suffix %} template-{{ template.name }}-{{ template.suffix }}{% endif %}">

  <a href="#main-content" class="sr-only skip-link">Skip to main content</a>

  {%- section 'header' -%}

  <main id="main-content" tabindex="-1">
    {{ content_for_layout }}
  </main>

  {%- section 'footer' -%}

  <script src="{{ 'theme.js' | asset_url }}" defer></script>

  {%- if settings.enable_animations == false -%}
    <style>
      .fade-up, .fade-in { opacity: 1 !important; transform: none !important; }
    </style>
  {%- endif -%}

</body>
</html>
