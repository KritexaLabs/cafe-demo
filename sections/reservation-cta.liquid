<style>
.reservation-cta {
  position: relative;
  padding-block: var(--sp-xl);
  text-align: center;
  overflow: hidden;
}
.reservation-cta__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.reservation-cta__bg img {
  width: 100%; height: 100%;
  object-fit: cover;
  opacity: 0.25;
}
.reservation-cta__overlay {
  position: absolute;
  inset: 0;
  background: var(--color-bg);
  opacity: 0.7;
  z-index: 1;
}
.reservation-cta__content {
  position: relative;
  z-index: 2;
  max-width: 680px;
  margin-inline: auto;
}
.reservation-cta__content .eyebrow { margin-bottom: 1rem; }
.reservation-cta__content .section-title { margin-bottom: 1rem; }
.reservation-cta__content p {
  color: var(--color-muted);
  margin-bottom: 2rem;
  font-size: 1rem;
}
.reservation-cta__actions { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }
</style>

<section class="reservation-cta" id="reservation-cta">
  <div class="reservation-cta__bg">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="" loading="lazy" aria-hidden="true">
    {%- endif -%}
  </div>
  <div class="reservation-cta__overlay"></div>
  <div class="container reservation-cta__content">
    <p class="eyebrow fade-up">{{ section.settings.eyebrow | default: 'Reservations' }}</p>
    <h2 class="section-title fade-up">{{ section.settings.heading | default: 'Reserve Your Table' }}</h2>
    <p class="fade-up">{{ section.settings.description | default: 'Join us for an unforgettable dining experience. Book your table today.' }}</p>
    <div class="reservation-cta__actions fade-up">
      <a href="{{ settings.reservation_url | default: '/pages/reservation' }}" class="btn btn--primary">
        {{ settings.reservation_btn_text | default: 'Book a Table' }}
      </a>
      {%- if section.settings.secondary_btn_text != blank -%}
        <a href="{{ section.settings.secondary_btn_url | default: '/pages/contact' }}" class="btn btn--ghost">
          {{ section.settings.secondary_btn_text }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Reservation CTA",
  "tag": "div",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Reservations" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reserve Your Table" },
    { "type": "text", "id": "description", "label": "Description", "default": "Join us for an unforgettable dining experience. Book your table today." },
    { "type": "text", "id": "secondary_btn_text", "label": "Secondary button text", "default": "Contact Us" },
    { "type": "url", "id": "secondary_btn_url", "label": "Secondary button URL" }
  ],
  "presets": [{ "name": "Reservation CTA" }]
}
{% endschema %}
