<style>
.site-footer {
  background: #050505;
  color: rgba(245,241,234,0.55);
  padding-top: var(--sp-xl);
  padding-bottom: var(--sp-md);
  border-top: 1px solid rgba(197,168,128,0.1);
}

/* 3-column blueprint layout */
.footer-grid {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 4rem;
  margin-bottom: var(--sp-xl);
  align-items: start;
}

/* ── Left: Contact + Hours ── */
.footer-col__label {
  font-family: var(--font-body);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 1.5rem;
  display: block;
}
.footer-contact-item {
  font-size: 0.85rem;
  color: rgba(245,241,234,0.45);
  line-height: 1.85;
  margin-bottom: 0.5rem;
}
.footer-contact-item a { transition: color var(--transition); }
.footer-contact-item a:hover { color: var(--color-white); }

.footer-phone-cta {
  display: inline-flex;
  align-items: center;
  gap: 0.6rem;
  font-family: var(--font-heading);
  font-size: 1.4rem;
  font-style: italic;
  color: var(--color-accent);
  margin: 1.25rem 0;
  transition: color var(--transition);
}
.footer-phone-cta:hover { color: var(--color-white); }

.footer-hours-grid { margin-top: 1.5rem; }
.footer-hours-row {
  display: flex;
  justify-content: space-between;
  font-size: 0.8rem;
  color: rgba(245,241,234,0.4);
  padding: 0.3rem 0;
  border-bottom: 1px solid rgba(245,241,234,0.05);
}
.footer-hours-row:last-child { border-bottom: none; }
.footer-hours-row .day { color: rgba(245,241,234,0.65); }

/* ── Center: Newsletter ── */
.footer-newsletter { text-align: center; }
.footer-newsletter__logo {
  font-family: var(--font-heading);
  font-size: 2rem;
  font-style: italic;
  color: var(--color-white);
  display: block;
  margin-bottom: 0.75rem;
}
.footer-newsletter__tagline {
  font-size: 0.82rem;
  color: rgba(245,241,234,0.4);
  line-height: 1.8;
  margin-bottom: 2rem;
  max-width: 260px;
  margin-inline: auto;
}
.footer-newsletter__form {
  display: flex;
  border: 1px solid rgba(197,168,128,0.25);
  overflow: hidden;
}
.footer-newsletter__input {
  flex: 1;
  background: rgba(255,255,255,0.04);
  border: none;
  color: var(--color-text);
  font-family: var(--font-body);
  font-size: 0.78rem;
  padding: 0.85rem 1rem;
  outline: none;
  min-width: 0;
}
.footer-newsletter__input::placeholder { color: rgba(245,241,234,0.25); }
.footer-newsletter__input:focus { background: rgba(197,168,128,0.06); }
.footer-newsletter__submit {
  background: var(--color-accent);
  border: none;
  color: var(--color-bg);
  padding: 0 1.25rem;
  cursor: pointer;
  font-size: 1rem;
  transition: background var(--transition);
  flex-shrink: 0;
}
.footer-newsletter__submit:hover { background: var(--color-accent-dk); }
.footer-newsletter__note {
  font-size: 0.68rem;
  color: rgba(245,241,234,0.25);
  margin-top: 0.75rem;
}

/* ── Right: Social + Nav ── */
.footer-social-col { text-align: right; }
.footer-social-icons {
  display: flex;
  gap: 0.6rem;
  justify-content: flex-end;
  margin-bottom: 2rem;
}
.footer-social-icons a {
  width: 38px; height: 38px;
  border: 1px solid rgba(245,241,234,0.1);
  border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  color: rgba(245,241,234,0.35);
  font-size: 0.7rem;
  font-weight: 600;
  letter-spacing: 0.04em;
  transition: var(--transition);
}
.footer-social-icons a:hover {
  border-color: var(--color-accent);
  color: var(--color-accent);
}
.footer-nav-links {
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
  align-items: flex-end;
}
.footer-nav-links a {
  font-size: 0.78rem;
  color: rgba(245,241,234,0.35);
  transition: color var(--transition);
  letter-spacing: 0.04em;
}
.footer-nav-links a:hover { color: var(--color-white); }

/* ── Bottom bar ── */
.footer-bottom {
  border-top: 1px solid rgba(245,241,234,0.06);
  padding-top: var(--sp-md);
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 0.5rem;
}
.footer-bottom p { font-size: 0.72rem; color: rgba(245,241,234,0.22); }

@media (max-width: 1024px) {
  .footer-grid { grid-template-columns: 1fr 1fr; gap: 3rem; }
  .footer-social-col { text-align: left; }
  .footer-social-icons { justify-content: flex-start; }
  .footer-nav-links { align-items: flex-start; }
  .footer-newsletter { text-align: left; }
  .footer-newsletter__tagline { margin-inline: 0; }
}
@media (max-width: 640px) {
  .footer-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .footer-bottom { flex-direction: column; text-align: center; }
}
</style>

<footer class="site-footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">

      <!-- Left: Contact + Hours -->
      <div class="footer-left">
        <span class="footer-col__label">Find Us</span>
        <p class="footer-contact-item">{{ settings.address_line1 }}<br>{{ settings.address_line2 }}<br>{{ settings.address_country }}</p>
        {%- if settings.phone != blank -%}
          <a href="tel:{{ settings.phone }}" class="footer-phone-cta">{{ settings.phone }}</a>
        {%- endif -%}
        {%- if settings.email != blank -%}
          <p class="footer-contact-item"><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></p>
        {%- endif -%}
        <div class="footer-hours-grid">
          {%- assign days = 'Monday,Tuesday,Wednesday,Thursday,Friday,Saturday,Sunday' | split: ',' -%}
          {%- assign keys = 'hours_monday,hours_tuesday,hours_wednesday,hours_thursday,hours_friday,hours_saturday,hours_sunday' | split: ',' -%}
          {%- for day in days -%}
            <div class="footer-hours-row">
              <span class="day">{{ day }}</span>
              <span>{{ settings[keys[forloop.index0]] }}</span>
            </div>
          {%- endfor -%}
        </div>
      </div>

      <!-- Center: Newsletter -->
      <div class="footer-newsletter">
        {%- if settings.logo -%}
          <a href="{{ routes.root_url }}">
            <img src="{{ settings.logo | image_url: width: 140 }}" alt="{{ settings.restaurant_name }}" width="140" style="margin-inline:auto; margin-bottom:1rem;">
          </a>
        {%- else -%}
          <a href="{{ routes.root_url }}" class="footer-newsletter__logo">{{ settings.restaurant_name }}</a>
        {%- endif -%}
        <p class="footer-newsletter__tagline">{{ section.settings.newsletter_tagline | default: 'Stay in the loop — special menus, events & exclusive offers.' }}</p>
        <form class="footer-newsletter__form" action="/contact#contact_form" method="post" accept-charset="UTF-8">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input
            class="footer-newsletter__input"
            type="email"
            name="contact[email]"
            placeholder="{{ section.settings.newsletter_placeholder | default: 'Your email address' }}"
            required
            aria-label="Email address"
          >
          <button type="submit" class="footer-newsletter__submit" aria-label="Subscribe">&#8594;</button>
        </form>
        <p class="footer-newsletter__note">{{ section.settings.newsletter_note | default: 'No spam. Unsubscribe anytime.' }}</p>
      </div>

      <!-- Right: Social + Nav -->
      <div class="footer-social-col">
        <span class="footer-col__label">Follow Us</span>
        <div class="footer-social-icons">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" aria-label="Instagram" rel="noopener noreferrer" target="_blank">IG</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" aria-label="Facebook" rel="noopener noreferrer" target="_blank">FB</a>
          {%- endif -%}
          {%- if settings.social_tiktok != blank -%}
            <a href="{{ settings.social_tiktok }}" aria-label="TikTok" rel="noopener noreferrer" target="_blank">TK</a>
          {%- endif -%}
          {%- if settings.social_twitter != blank -%}
            <a href="{{ settings.social_twitter }}" aria-label="X / Twitter" rel="noopener noreferrer" target="_blank">X</a>
          {%- endif -%}
        </div>
        <nav class="footer-nav-links" aria-label="Footer navigation">
          {%- for link in section.settings.footer_menu.links -%}
            <a href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </nav>
      </div>

    </div>

    <div class="footer-bottom">
      <p>{{ settings.footer_copyright }}</p>
      <p>Powered by Shopify</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "link_list", "id": "footer_menu",           "label": "Footer menu",           "default": "footer" },
    { "type": "text",      "id": "newsletter_tagline",    "label": "Newsletter tagline",    "default": "Stay in the loop — special menus, events & exclusive offers." },
    { "type": "text",      "id": "newsletter_placeholder","label": "Email placeholder",     "default": "Your email address" },
    { "type": "text",      "id": "newsletter_note",       "label": "Newsletter note",       "default": "No spam. Unsubscribe anytime." }
  ]
}
{% endschema %}
