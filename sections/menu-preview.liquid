<style>
.menu-preview { background: var(--color-surface); padding-block: var(--sp-xl); }

.menu-filter-bar {
  display: flex;
  gap: 0.25rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: var(--sp-lg);
}
.menu-filter-btn {
  font-family: var(--font-body);
  font-size: 0.6rem;
  font-weight: 500;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--color-muted);
  padding: 0.55rem 1.4rem;
  border: 1px solid var(--color-border-lt);
  background: none;
  cursor: pointer;
  transition: var(--transition);
}
.menu-filter-btn:hover,
.menu-filter-btn.active {
  border-color: var(--color-accent);
  color: var(--color-accent);
}

/* Editorial row layout — typographic block with dotted leader */
.menu-rows { max-width: 900px; margin-inline: auto; }
.menu-row {
  display: grid;
  grid-template-columns: 1fr auto;
  align-items: baseline;
  gap: 1rem;
  padding: 1.5rem 0;
  border-bottom: 1px solid var(--color-border-lt);
  transition: border-color var(--transition);
}
.menu-row:first-child { border-top: 1px solid var(--color-border-lt); }
.menu-row:hover { border-bottom-color: var(--color-accent); }
.menu-row__left {}
.menu-row__category {
  font-size: 0.58rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 0.3rem;
}
.menu-row__name-line {
  display: flex;
  align-items: baseline;
  gap: 0;
  margin-bottom: 0.3rem;
}
.menu-row__name {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 400;
  color: var(--color-white);
  flex-shrink: 0;
}
.menu-row__dots {
  flex: 1;
  border-bottom: 1px dotted rgba(197,168,128,0.25);
  margin: 0 0.75rem;
  margin-bottom: 0.2rem;
}
.menu-row__price-inline {
  font-family: var(--font-heading);
  font-size: 1.1rem;
  font-style: italic;
  color: var(--color-accent);
  white-space: nowrap;
  flex-shrink: 0;
}
.menu-row__desc {
  font-size: 0.82rem;
  color: var(--color-muted);
  line-height: 1.6;
}
.menu-row__right { display: none; }
.menu-row__dietary {
  font-size: 0.6rem;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-muted);
  margin-top: 0.25rem;
}
.menu-row__badge {
  display: inline-block;
  font-size: 0.55rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: var(--color-bg);
  background: var(--color-accent);
  padding: 0.2rem 0.5rem;
  margin-left: 0.5rem;
  vertical-align: middle;
}

/* Empty state */
.menu-empty {
  text-align: center;
  padding: 5rem 2rem;
  border: 1px solid var(--color-border-lt);
}
.menu-empty__icon { font-size: 2.5rem; opacity: 0.3; margin-bottom: 1.25rem; }
.menu-empty__title { font-family: var(--font-heading); font-size: 1.6rem; font-style: italic; color: var(--color-white); margin-bottom: 0.6rem; }
.menu-empty__text { font-size: 0.88rem; color: var(--color-muted); max-width: 400px; margin: 0 auto 1.5rem; line-height: 1.7; }

.menu-cta { text-align: center; margin-top: var(--sp-lg); }
</style>

{%- liquid
  assign menu_items = shop.metaobjects.menu_item.values
  assign has_metaobjects = false
  if menu_items.size > 0
    assign has_metaobjects = true
  endif
  assign has_blocks = false
  for block in section.blocks
    if block.type == 'menu_item'
      assign has_blocks = true
      break
    endif
  endfor
-%}

<section class="menu-preview section-padding" id="menu">
  <div class="container">
    <div class="section-header section-header--center">
      <p class="eyebrow fade-up">{{ section.settings.eyebrow | default: 'Our Menu' }}</p>
      <h2 class="section-title fade-up">{{ section.settings.heading | default: 'Crafted with Passion' }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle fade-up" style="margin-inline:auto;">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <span class="gold-rule gold-rule--center"></span>
    </div>

    <div class="menu-filter-bar" role="group" aria-label="Filter by category">
      <button class="menu-filter-btn active" data-category="all" aria-pressed="true">All</button>
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <button class="menu-filter-btn" data-category="{{ block.settings.category_id }}" aria-pressed="false" {{ block.shopify_attributes }}>
            {{ block.settings.label }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <div class="menu-rows">
      {%- if has_metaobjects -%}
        {%- for item in menu_items -%}
          {%- if item.available.value == true or item.available == blank -%}
            <div class="menu-row fade-up" data-category="{{ item.category.value }}">
              <div class="menu-row__left">
                <p class="menu-row__category">{{ item.category.value }}</p>
                <div class="menu-row__name-line">
                  <h3 class="menu-row__name">
                    {{ item.title.value }}
                    {%- if item.featured.value == true -%}<span class="menu-row__badge">Chef's Pick</span>{%- endif -%}
                  </h3>
                  <span class="menu-row__dots" aria-hidden="true"></span>
                  <span class="menu-row__price-inline">{{ item.price.value }}</span>
                </div>
                {%- if item.description.value != blank -%}
                  <p class="menu-row__desc">{{ item.description.value }}</p>
                {%- endif -%}
                {%- if item.dietary_info.value != blank -%}
                  <p class="menu-row__dietary">{{ item.dietary_info.value }}</p>
                {%- endif -%}
              </div>
              <div class="menu-row__right"></div>
            </div>
          {%- endif -%}
        {%- endfor -%}

      {%- elsif has_blocks -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu_item' -%}
            <div class="menu-row fade-up" data-category="{{ block.settings.category }}" {{ block.shopify_attributes }}>
              <div class="menu-row__left">
                <p class="menu-row__category">{{ block.settings.category }}</p>
                <div class="menu-row__name-line">
                  <h3 class="menu-row__name">
                    {{ block.settings.name }}
                    {%- if block.settings.featured -%}<span class="menu-row__badge">Chef's Pick</span>{%- endif -%}
                  </h3>
                  <span class="menu-row__dots" aria-hidden="true"></span>
                  <span class="menu-row__price-inline">{{ block.settings.price }}</span>
                </div>
                {%- if block.settings.description != blank -%}
                  <p class="menu-row__desc">{{ block.settings.description }}</p>
                {%- endif -%}
                {%- if block.settings.dietary != blank -%}
                  <p class="menu-row__dietary">{{ block.settings.dietary }}</p>
                {%- endif -%}
              </div>
              <div class="menu-row__right"></div>
            </div>
          {%- endif -%}
        {%- endfor -%}

      {%- else -%}
        <div class="menu-empty">
          <div class="menu-empty__icon">🍴</div>
          <h3 class="menu-empty__title">Your Menu Awaits</h3>
          <p class="menu-empty__text">Add menu items from the Theme Customizer to populate this section.</p>
        </div>
      {%- endif -%}
    </div>

    {%- if section.settings.btn_text != blank -%}
      <div class="menu-cta fade-up">
        <a href="{{ section.settings.menu_url | default: '/pages/menu' }}" class="btn btn--outline">
          {{ section.settings.btn_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
(function(){
  var btns = document.querySelectorAll('.menu-filter-btn');
  var rows = document.querySelectorAll('.menu-row');
  btns.forEach(function(btn){
    btn.addEventListener('click', function(){
      var cat = this.dataset.category;
      btns.forEach(function(b){ b.classList.remove('active'); b.setAttribute('aria-pressed','false'); });
      this.classList.add('active'); this.setAttribute('aria-pressed','true');
      rows.forEach(function(r){ r.style.display = (cat === 'all' || r.dataset.category === cat) ? '' : 'none'; });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Menu Preview",
  "settings": [
    { "type": "text",     "id": "eyebrow",    "label": "Eyebrow",      "default": "Our Menu" },
    { "type": "text",     "id": "heading",    "label": "Heading",      "default": "Crafted with Passion" },
    { "type": "textarea", "id": "subheading", "label": "Subheading" },
    { "type": "text",     "id": "btn_text",   "label": "Button text",  "default": "Discover Entire Menu" },
    { "type": "url",      "id": "menu_url",   "label": "Menu page URL" }
  ],
  "blocks": [
    { "type": "category", "name": "Category Filter", "settings": [
      { "type": "text", "id": "label",       "label": "Label",       "default": "Starters" },
      { "type": "text", "id": "category_id", "label": "Category ID", "default": "starters" }
    ]},
    { "type": "menu_item", "name": "Menu Item", "settings": [
      { "type": "text",     "id": "name",        "label": "Dish name",    "default": "Signature Dish" },
      { "type": "textarea", "id": "description", "label": "Description",  "default": "A beautifully crafted dish made with the finest seasonal ingredients." },
      { "type": "text",     "id": "price",       "label": "Price",        "default": "$28" },
      { "type": "text",     "id": "category",    "label": "Category",     "default": "starters" },
      { "type": "text",     "id": "dietary",     "label": "Dietary info" },
      { "type": "checkbox", "id": "featured",    "label": "Chef's Pick",  "default": false }
    ]}
  ],
  "presets": [{ "name": "Menu Preview", "blocks": [
    { "type": "category",  "settings": { "label": "Starters",    "category_id": "starters" } },
    { "type": "category",  "settings": { "label": "Main Course", "category_id": "mains" } },
    { "type": "category",  "settings": { "label": "Seafood",     "category_id": "seafood" } },
    { "type": "category",  "settings": { "label": "Steaks",      "category_id": "steaks" } },
    { "type": "category",  "settings": { "label": "Desserts",    "category_id": "desserts" } },
    { "type": "category",  "settings": { "label": "Drinks",      "category_id": "drinks" } },
    { "type": "menu_item", "settings": { "name": "Seared Scallops",      "description": "Pan-seared diver scallops with cauliflower purée, crispy capers and brown butter.", "price": "$22", "category": "starters",  "dietary": "GF",    "featured": true } },
    { "type": "menu_item", "settings": { "name": "Wagyu Beef Tenderloin","description": "8oz prime cut, truffle butter, roasted garlic mash and seasonal vegetables.",        "price": "$68", "category": "steaks",   "dietary": "GF",    "featured": false } },
    { "type": "menu_item", "settings": { "name": "Lobster Bisque",       "description": "Velvety Maine lobster bisque with a touch of cognac and fresh chive cream.",          "price": "$18", "category": "starters",  "dietary": "",      "featured": false } },
    { "type": "menu_item", "settings": { "name": "Pan-Roasted Salmon",   "description": "Atlantic salmon, lemon beurre blanc, asparagus and wild rice pilaf.",                 "price": "$38", "category": "seafood",   "dietary": "GF",    "featured": false } },
    { "type": "menu_item", "settings": { "name": "Truffle Tagliatelle",  "description": "House-made pasta, black truffle, parmesan cream and toasted pine nuts.",              "price": "$32", "category": "mains",     "dietary": "V",     "featured": true } },
    { "type": "menu_item", "settings": { "name": "Chocolate Fondant",    "description": "Warm dark chocolate fondant, vanilla bean ice cream and raspberry coulis.",            "price": "$14", "category": "desserts",  "dietary": "V",     "featured": false } }
  ]}]
}
{% endschema %}
