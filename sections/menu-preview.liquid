<style>
.menu-preview { background: var(--color-bg); }
.menu-filter-bar {
  display: flex;
  gap: 0.5rem;
  flex-wrap: wrap;
  justify-content: center;
  margin-bottom: var(--sp-lg);
}
.menu-filter-btn {
  font-family: var(--font-body);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
  padding: 0.55rem 1.4rem;
  border: 1px solid var(--color-border);
  border-radius: 100px;
  background: none;
  cursor: pointer;
  transition: var(--transition);
}
.menu-filter-btn:hover,
.menu-filter-btn.active {
  border-color: var(--color-accent);
  color: var(--color-accent);
  background: rgba(201,169,110,0.08);
}
.menu-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.menu-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  overflow: hidden;
  transition: transform var(--transition), box-shadow var(--transition);
}
.menu-card:hover {
  transform: translateY(-4px);
  box-shadow: var(--shadow-md);
}
.menu-card__img {
  width: 100%;
  aspect-ratio: 4/3;
  object-fit: cover;
}
.menu-card__img-placeholder {
  width: 100%;
  aspect-ratio: 4/3;
  background: var(--color-surface-2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted);
  font-size: 2rem;
}
.menu-card__body { padding: 1.25rem; }
.menu-card__category {
  font-size: 0.62rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 0.4rem;
}
.menu-card__name {
  font-family: var(--font-heading);
  font-size: 1.3rem;
  margin-bottom: 0.4rem;
}
.menu-card__desc {
  font-size: 0.85rem;
  color: var(--color-muted);
  line-height: 1.7;
  margin-bottom: 0.75rem;
}
.menu-card__footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.menu-card__price {
  font-family: var(--font-heading);
  font-size: 1.2rem;
  color: var(--color-accent);
}
.menu-card__dietary {
  font-size: 0.68rem;
  color: var(--color-muted);
  letter-spacing: 0.08em;
}
.menu-cta { text-align: center; margin-top: var(--sp-lg); }

@media (max-width: 1024px) { .menu-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 576px) { .menu-grid { grid-template-columns: 1fr; } }
</style>

<section class="menu-preview" id="menu">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow fade-up">{{ section.settings.eyebrow | default: 'Our Menu' }}</p>
      <h2 class="section-title fade-up">{{ section.settings.heading | default: 'Crafted with Passion' }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-subtitle fade-up" style="margin-inline:auto;">{{ section.settings.subheading }}</p>
      {%- endif -%}
      <div class="gold-line"></div>
    </div>

    <!-- Category Filters -->
    <div class="menu-filter-bar" role="group" aria-label="Filter menu by category">
      <button class="menu-filter-btn active" data-category="all" aria-pressed="true">All</button>
      {%- for block in section.blocks -%}
        {%- if block.type == 'category' -%}
          <button class="menu-filter-btn" data-category="{{ block.settings.category_id }}" aria-pressed="false" {{ block.shopify_attributes }}>
            {{ block.settings.label }}
          </button>
        {%- endif -%}
      {%- endfor -%}
    </div>

    <!-- Menu Items from Metaobjects -->
    <div class="menu-grid">
      {%- assign menu_items = shop.metaobjects.menu_item.values -%}
      {%- if menu_items.size > 0 -%}
        {%- for item in menu_items -%}
          {%- if item.available.value == true or item.available == blank -%}
            <article class="menu-card fade-up" data-category="{{ item.category.value }}">
              {%- if item.image.value != blank -%}
                <img
                  class="menu-card__img"
                  src="{{ item.image.value | image_url: width: 600 }}"
                  alt="{{ item.title.value }}"
                  loading="lazy"
                  width="600"
                >
              {%- else -%}
                <div class="menu-card__img-placeholder" aria-hidden="true">🍽</div>
              {%- endif -%}
              <div class="menu-card__body">
                <p class="menu-card__category">{{ item.category.value }}</p>
                <h3 class="menu-card__name">{{ item.title.value }}</h3>
                {%- if item.description.value != blank -%}
                  <p class="menu-card__desc">{{ item.description.value }}</p>
                {%- endif -%}
                <div class="menu-card__footer">
                  <span class="menu-card__price">{{ item.price.value }}</span>
                  {%- if item.dietary_info.value != blank -%}
                    <span class="menu-card__dietary">{{ item.dietary_info.value }}</span>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        <!-- Placeholder cards shown when no metaobjects exist yet -->
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu_item' -%}
            <article class="menu-card fade-up" data-category="{{ block.settings.category }}" {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <img class="menu-card__img" src="{{ block.settings.image | image_url: width: 600 }}" alt="{{ block.settings.name }}" loading="lazy" width="600">
              {%- else -%}
                <div class="menu-card__img-placeholder" aria-hidden="true">🍽</div>
              {%- endif -%}
              <div class="menu-card__body">
                <p class="menu-card__category">{{ block.settings.category }}</p>
                <h3 class="menu-card__name">{{ block.settings.name }}</h3>
                <p class="menu-card__desc">{{ block.settings.description }}</p>
                <div class="menu-card__footer">
                  <span class="menu-card__price">{{ block.settings.price }}</span>
                  <span class="menu-card__dietary">{{ block.settings.dietary }}</span>
                </div>
              </div>
            </article>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>

    <div class="menu-cta fade-up">
      <a href="{{ section.settings.menu_url | default: '/pages/menu' }}" class="btn btn--outline">
        {{ section.settings.btn_text | default: 'View Full Menu' }}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Menu Preview",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Menu" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted with Passion" },
    { "type": "text", "id": "subheading", "label": "Subheading" },
    { "type": "text", "id": "btn_text", "label": "Button text", "default": "View Full Menu" },
    { "type": "url", "id": "menu_url", "label": "Menu page URL" }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category Filter",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Starters" },
        { "type": "text", "id": "category_id", "label": "Category ID (matches metaobject)", "default": "starters" }
      ]
    },
    {
      "type": "menu_item",
      "name": "Menu Item (fallback)",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "name", "label": "Name", "default": "Signature Dish" },
        { "type": "text", "id": "description", "label": "Description", "default": "A beautifully crafted dish." },
        { "type": "text", "id": "price", "label": "Price", "default": "$00" },
        { "type": "text", "id": "category", "label": "Category", "default": "starters" },
        { "type": "text", "id": "dietary", "label": "Dietary info" }
      ]
    }
  ],
  "presets": [{
    "name": "Menu Preview",
    "blocks": [
      { "type": "category", "settings": { "label": "Starters", "category_id": "starters" } },
      { "type": "category", "settings": { "label": "Main Course", "category_id": "mains" } },
      { "type": "category", "settings": { "label": "Seafood", "category_id": "seafood" } },
      { "type": "category", "settings": { "label": "Steaks", "category_id": "steaks" } },
      { "type": "category", "settings": { "label": "Desserts", "category_id": "desserts" } },
      { "type": "category", "settings": { "label": "Drinks", "category_id": "drinks" } }
    ]
  }]
}
{% endschema %}
