<style>
.testimonials { background: var(--color-surface-2); padding-block: var(--sp-xl); }

/* 3-column card grid */
.testimonials__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.testimonial-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border-lt);
  padding: 2.5rem 2rem;
  display: flex;
  flex-direction: column;
  transition: border-color var(--transition), transform var(--transition);
}
.testimonial-card:hover {
  border-color: rgba(197,168,128,0.3);
  transform: translateY(-4px);
}

.testimonial-card__quote {
  font-family: var(--font-heading);
  font-size: 4rem;
  line-height: 1;
  color: var(--color-accent);
  opacity: 0.4;
  margin-bottom: 1rem;
  display: block;
  user-select: none;
}

.testimonial-card__stars {
  color: var(--color-accent);
  font-size: 0.7rem;
  letter-spacing: 0.1em;
  margin-bottom: 1.25rem;
}

.testimonial-card__text {
  font-family: var(--font-heading);
  font-size: 1rem;
  font-style: italic;
  font-weight: 400;
  color: rgba(229,229,229,0.85);
  line-height: 1.7;
  flex: 1;
  margin-bottom: 2rem;
}

.testimonial-card__footer {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding-top: 1.25rem;
  border-top: 1px solid var(--color-border-lt);
}

.testimonial-card__avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  object-fit: cover;
  flex-shrink: 0;
  border: 1px solid rgba(197,168,128,0.2);
}
.testimonial-card__avatar-placeholder {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: var(--color-surface-2);
  border: 1px solid var(--color-border-lt);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  font-family: var(--font-heading);
  font-size: 1rem;
  font-style: italic;
  color: var(--color-accent);
}

.testimonial-card__meta { flex: 1; }
.testimonial-card__name {
  font-family: var(--font-body);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--color-white);
  display: block;
}
.testimonial-card__date {
  font-size: 0.68rem;
  color: var(--color-muted);
  margin-top: 0.15rem;
  display: block;
}

/* Social proof links */
.testimonials__social {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2rem;
  margin-top: var(--sp-lg);
  padding-top: var(--sp-md);
  border-top: 1px solid var(--color-border-lt);
}
.testimonials__social-label {
  font-size: 0.6rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--color-muted);
}
.testimonials__social-links { display: flex; gap: 1.25rem; }
.testimonials__social-links a {
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--color-muted);
  transition: color var(--transition);
  padding-bottom: 2px;
  border-bottom: 1px solid transparent;
}
.testimonials__social-links a:hover {
  color: var(--color-accent);
  border-bottom-color: var(--color-accent);
}

@media (max-width: 1024px) { .testimonials__grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 640px)  { .testimonials__grid { grid-template-columns: 1fr; } }
</style>

<section class="testimonials" id="testimonials">
  <div class="container">
    <div class="section-header section-header--center">
      <p class="eyebrow fade-up">{{ section.settings.eyebrow | default: 'Guest Reviews' }}</p>
      <h2 class="section-title fade-up">{{ section.settings.heading | default: 'What Our Guests Say' }}</h2>
      <span class="gold-rule gold-rule--center"></span>
    </div>

    {%- if section.blocks.size > 0 -%}
      <div class="testimonials__grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'testimonial' -%}
            <div class="testimonial-card fade-up" {{ block.shopify_attributes }}>
              <span class="testimonial-card__quote" aria-hidden="true">"</span>
              <div class="testimonial-card__stars" aria-label="{{ block.settings.rating }} out of 5">
                {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
              </div>
              <p class="testimonial-card__text">"{{ block.settings.review }}"</p>
              <div class="testimonial-card__footer">
                {%- if block.settings.avatar != blank -%}
                  <img class="testimonial-card__avatar" src="{{ block.settings.avatar | image_url: width: 80 }}" alt="{{ block.settings.name }}" width="40" height="40" loading="lazy">
                {%- else -%}
                  <div class="testimonial-card__avatar-placeholder" aria-hidden="true">{{ block.settings.name | slice: 0 }}</div>
                {%- endif -%}
                <div class="testimonial-card__meta">
                  <span class="testimonial-card__name">{{ block.settings.name }}</span>
                  {%- if block.settings.date != blank -%}
                    <span class="testimonial-card__date">{{ block.settings.date }}</span>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_social_links -%}
        <div class="testimonials__social fade-up">
          <span class="testimonials__social-label">Verified on</span>
          <div class="testimonials__social-links">
            {%- if section.settings.yelp_url != blank -%}
              <a href="{{ section.settings.yelp_url }}" target="_blank" rel="noopener noreferrer">Yelp</a>
            {%- endif -%}
            {%- if section.settings.facebook_url != blank -%}
              <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener noreferrer">Facebook</a>
            {%- endif -%}
            {%- if section.settings.google_url != blank -%}
              <a href="{{ section.settings.google_url }}" target="_blank" rel="noopener noreferrer">Google</a>
            {%- endif -%}
          </div>
        </div>
      {%- endif -%}
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text",     "id": "eyebrow",           "label": "Eyebrow",              "default": "Guest Reviews" },
    { "type": "text",     "id": "heading",            "label": "Heading",              "default": "What Our Guests Say" },
    { "type": "checkbox", "id": "show_social_links",  "label": "Show social proof bar","default": true },
    { "type": "url",      "id": "yelp_url",           "label": "Yelp URL" },
    { "type": "url",      "id": "facebook_url",       "label": "Facebook URL" },
    { "type": "url",      "id": "google_url",         "label": "Google URL" }
  ],
  "blocks": [{ "type": "testimonial", "name": "Testimonial", "settings": [
    { "type": "textarea",     "id": "review", "label": "Review",      "default": "An exceptional dining experience from start to finish." },
    { "type": "text",         "id": "name",   "label": "Guest name",  "default": "Guest Name" },
    { "type": "text",         "id": "date",   "label": "Date",        "default": "October 2024" },
    { "type": "range",        "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
    { "type": "image_picker", "id": "avatar", "label": "Avatar photo" }
  ]}],
  "presets": [{ "name": "Testimonials", "blocks": [
    { "type": "testimonial", "settings": { "review": "An exceptional dining experience from start to finish. The food was outstanding and the service impeccable.", "name": "Sarah M.", "date": "October 2024", "rating": 5 } },
    { "type": "testimonial", "settings": { "review": "Megan The Restaurant is our go-to for special occasions. Every visit feels like a true celebration.", "name": "James R.", "date": "September 2024", "rating": 5 } },
    { "type": "testimonial", "settings": { "review": "The atmosphere is warm and sophisticated. Truly a gem in Johnston, Rhode Island.", "name": "Linda K.", "date": "August 2024", "rating": 5 } }
  ]}]
}
{% endschema %}
