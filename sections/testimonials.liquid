<style>
.testimonials { background: var(--color-bg); }
.testimonials-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}
.testimonial-card {
  background: var(--color-surface);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 2rem;
  position: relative;
}
.testimonial-card::before {
  content: '\201C';
  font-family: var(--font-heading);
  font-size: 5rem;
  color: var(--color-accent);
  opacity: 0.25;
  position: absolute;
  top: 0.5rem;
  left: 1.5rem;
  line-height: 1;
}
.testimonial-stars {
  color: var(--color-accent);
  font-size: 0.85rem;
  letter-spacing: 0.1em;
  margin-bottom: 1rem;
}
.testimonial-text {
  font-size: 0.95rem;
  color: var(--color-muted);
  line-height: 1.8;
  margin-bottom: 1.5rem;
  font-style: italic;
}
.testimonial-author {
  display: flex;
  align-items: center;
  gap: 0.75rem;
}
.testimonial-author img {
  width: 44px; height: 44px;
  border-radius: 50%;
  object-fit: cover;
}
.testimonial-author-info strong {
  display: block;
  font-size: 0.88rem;
  color: var(--color-text);
}
.testimonial-author-info span {
  font-size: 0.75rem;
  color: var(--color-muted);
}

@media (max-width: 1024px) { .testimonials-grid { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 576px) { .testimonials-grid { grid-template-columns: 1fr; } }
</style>

<section class="testimonials" id="testimonials">
  <div class="container">
    <div class="section-header">
      <p class="eyebrow fade-up">{{ section.settings.eyebrow | default: 'Guest Reviews' }}</p>
      <h2 class="section-title fade-up">{{ section.settings.heading | default: 'What Our Guests Say' }}</h2>
      <div class="gold-line"></div>
    </div>

    <div class="testimonials-grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'testimonial' -%}
          <div class="testimonial-card fade-up" {{ block.shopify_attributes }}>
            <div class="testimonial-stars" aria-label="{{ block.settings.rating }} out of 5 stars">
              {%- for i in (1..block.settings.rating) -%}★{%- endfor -%}
            </div>
            <p class="testimonial-text">{{ block.settings.review }}</p>
            <div class="testimonial-author">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 88 }}" alt="{{ block.settings.name }}" loading="lazy" width="44" height="44">
              {%- endif -%}
              <div class="testimonial-author-info">
                <strong>{{ block.settings.name }}</strong>
                <span>{{ block.settings.date }}</span>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Guest Reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Guests Say" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "review", "label": "Review", "default": "An exceptional dining experience from start to finish." },
        { "type": "text", "id": "name", "label": "Guest name", "default": "Guest Name" },
        { "type": "text", "id": "date", "label": "Date", "default": "October 2024" },
        { "type": "range", "id": "rating", "label": "Rating", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "image", "label": "Guest photo (optional)" }
      ]
    }
  ],
  "presets": [{
    "name": "Testimonials",
    "blocks": [
      { "type": "testimonial", "settings": { "review": "An exceptional dining experience from start to finish. The food was outstanding and the service impeccable.", "name": "Guest Name", "date": "October 2024", "rating": 5 } },
      { "type": "testimonial", "settings": { "review": "Megan The Restaurant is our go-to for special occasions. Every visit feels like a celebration.", "name": "Guest Name", "date": "September 2024", "rating": 5 } },
      { "type": "testimonial", "settings": { "review": "The atmosphere is warm and sophisticated. Truly a gem in Johnston.", "name": "Guest Name", "date": "August 2024", "rating": 5 } }
    ]
  }]
}
{% endschema %}
