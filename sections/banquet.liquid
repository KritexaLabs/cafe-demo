<style>
.banquet-section { background: var(--color-bg); padding-block: var(--sp-xl); }
.banquet-intro { display: grid; grid-template-columns: 1fr 1fr; gap: 6rem; align-items: center; margin-bottom: var(--sp-xl); }
.banquet-intro-text .eyebrow { margin-bottom: 0.85rem; }
.banquet-intro-text .section-title { margin-bottom: 1.25rem; }
.banquet-intro-text p { color: var(--color-muted); line-height: 1.9; margin-bottom: 1rem; }
.banquet-intro-img img { width: 100%; aspect-ratio: 4/3; object-fit: cover; }
.banquet-intro-img-placeholder { width: 100%; aspect-ratio: 4/3; background: var(--color-surface); }

.banquet-events-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1px; margin-bottom: var(--sp-xl); background: var(--color-border-lt); }
.banquet-event-card {
  background: var(--color-surface);
  padding: 2rem 1.25rem;
  text-align: center;
  transition: background var(--transition);
}
.banquet-event-card:hover { background: var(--color-surface-2); }
.banquet-event-icon { font-size: 1.6rem; margin-bottom: 0.75rem; }
.banquet-event-name { font-family: var(--font-heading); font-size: 1.05rem; font-style: italic; margin-bottom: 0.4rem; color: var(--color-white); }
.banquet-event-desc { font-size: 0.8rem; color: var(--color-muted); line-height: 1.6; }

.banquet-features { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; margin-bottom: var(--sp-lg); }
.banquet-feature { display: flex; gap: 1.25rem; align-items: flex-start; }
.banquet-feature-icon { color: var(--color-accent); font-size: 1.2rem; flex-shrink: 0; margin-top: 0.1rem; }
.banquet-feature-text h4 { font-size: 0.9rem; margin-bottom: 0.3rem; color: var(--color-white); font-family: var(--font-body); font-weight: 500; letter-spacing: 0.04em; }
.banquet-feature-text p { font-size: 0.8rem; color: var(--color-muted); line-height: 1.7; }
.banquet-cta { text-align: center; }

@media (max-width: 1024px) { .banquet-events-grid { grid-template-columns: repeat(2, 1fr); } .banquet-features { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 768px) { .banquet-intro { grid-template-columns: 1fr; gap: 3rem; } .banquet-features { grid-template-columns: 1fr; } }
@media (max-width: 480px) { .banquet-events-grid { grid-template-columns: 1fr; } }
</style>

<section class="banquet-section" id="banquets">
  <div class="container">
    <div class="banquet-intro">
      <div class="banquet-intro-text">
        <p class="eyebrow fade-up">{{ section.settings.eyebrow | default: 'Banquet & Events' }}</p>
        <h2 class="section-title fade-up">{{ section.settings.heading | default: 'Host Your Perfect Event' }}</h2>
        {%- if section.settings.description != blank -%}<div class="fade-up">{{ section.settings.description }}</div>{%- endif -%}
        {%- if section.settings.capacity_text != blank -%}
          <p class="fade-up" style="color:var(--color-accent);font-size:0.75rem;letter-spacing:0.14em;text-transform:uppercase;margin-top:1rem;">{{ section.settings.capacity_text }}</p>
        {%- endif -%}
        <a href="{{ section.settings.btn_url | default: '/pages/contact' }}" class="btn btn--outline fade-up" style="margin-top:1.5rem;">{{ section.settings.btn_text | default: 'Plan Your Event' }}</a>
      </div>
      <div class="banquet-intro-img fade-in">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 900 }}" alt="{{ section.settings.image.alt | default: 'Banquet facilities' }}" loading="lazy" width="900">
        {%- else -%}
          <div class="banquet-intro-img-placeholder"></div>
        {%- endif -%}
      </div>
    </div>

    {%- assign event_blocks = section.blocks | where: 'type', 'event_type' -%}
    {%- if event_blocks.size > 0 -%}
      <div class="section-header section-header--center" style="margin-bottom:var(--sp-md);">
        <p class="eyebrow fade-up">Occasions</p>
        <h3 class="section-title fade-up">Events We Host</h3>
        <span class="gold-rule gold-rule--center"></span>
      </div>
      <div class="banquet-events-grid">
        {%- for block in event_blocks -%}
          <div class="banquet-event-card fade-up" {{ block.shopify_attributes }}>
            <div class="banquet-event-icon" aria-hidden="true">{{ block.settings.icon | default: '🎉' }}</div>
            <h3 class="banquet-event-name">{{ block.settings.name }}</h3>
            <p class="banquet-event-desc">{{ block.settings.description }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- assign feature_blocks = section.blocks | where: 'type', 'feature' -%}
    {%- if feature_blocks.size > 0 -%}
      <div class="section-header section-header--center" style="margin-bottom:var(--sp-md);margin-top:var(--sp-lg);">
        <p class="eyebrow fade-up">Amenities</p>
        <h3 class="section-title fade-up">What We Offer</h3>
        <span class="gold-rule gold-rule--center"></span>
      </div>
      <div class="banquet-features">
        {%- for block in feature_blocks -%}
          <div class="banquet-feature fade-up" {{ block.shopify_attributes }}>
            <span class="banquet-feature-icon" aria-hidden="true">{{ block.settings.icon | default: '✓' }}</span>
            <div class="banquet-feature-text"><h4>{{ block.settings.title }}</h4><p>{{ block.settings.description }}</p></div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="banquet-cta fade-up">
      <a href="{{ section.settings.btn_url | default: '/pages/contact' }}" class="btn btn--primary">{{ section.settings.btn_text | default: 'Plan Your Event' }}</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Banquet",
  "settings": [
    { "type": "text",         "id": "eyebrow",       "label": "Eyebrow",       "default": "Banquet & Events" },
    { "type": "text",         "id": "heading",       "label": "Heading",       "default": "Host Your Perfect Event" },
    { "type": "richtext",     "id": "description",   "label": "Description",   "default": "<p>From intimate gatherings to grand celebrations, our banquet facilities provide the perfect setting for every occasion.</p>" },
    { "type": "text",         "id": "capacity_text", "label": "Capacity info" },
    { "type": "image_picker", "id": "image",         "label": "Banquet image" },
    { "type": "text",         "id": "btn_text",      "label": "Button text",   "default": "Plan Your Event" },
    { "type": "url",          "id": "btn_url",       "label": "Button URL" }
  ],
  "blocks": [
    { "type": "event_type", "name": "Event Type", "settings": [
      { "type": "text", "id": "icon",        "label": "Emoji icon",        "default": "🎉" },
      { "type": "text", "id": "name",        "label": "Event name",        "default": "Weddings" },
      { "type": "text", "id": "description", "label": "Short description", "default": "Celebrate your special day with us." }
    ]},
    { "type": "feature", "name": "Feature / Amenity", "settings": [
      { "type": "text", "id": "icon",        "label": "Emoji icon",  "default": "✓" },
      { "type": "text", "id": "title",       "label": "Title",       "default": "Private Dining Room" },
      { "type": "text", "id": "description", "label": "Description", "default": "[Details to be added]" }
    ]}
  ],
  "presets": [{ "name": "Banquet", "blocks": [
    { "type": "event_type", "settings": { "icon": "💍", "name": "Weddings",        "description": "Celebrate your special day with us." } },
    { "type": "event_type", "settings": { "icon": "💼", "name": "Corporate Events","description": "Professional settings for business gatherings." } },
    { "type": "event_type", "settings": { "icon": "🎂", "name": "Birthday Parties","description": "Make your birthday truly memorable." } },
    { "type": "event_type", "settings": { "icon": "🥂", "name": "Private Dining",  "description": "Exclusive dining for intimate occasions." } },
    { "type": "event_type", "settings": { "icon": "💑", "name": "Anniversaries",   "description": "Celebrate milestones in style." } },
    { "type": "event_type", "settings": { "icon": "🎊", "name": "Celebrations",    "description": "Any occasion worth celebrating." } },
    { "type": "event_type", "settings": { "icon": "🥳", "name": "Receptions",      "description": "Elegant receptions for every event." } },
    { "type": "feature", "settings": { "icon": "🍽", "title": "Full Catering Service", "description": "[Details to be added]" } },
    { "type": "feature", "settings": { "icon": "🎵", "title": "AV Equipment",          "description": "[Details to be added]" } },
    { "type": "feature", "settings": { "icon": "🅿", "title": "Parking Available",      "description": "[Details to be added]" } }
  ]}]
}
{% endschema %}
