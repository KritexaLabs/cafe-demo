<style>
.welcome-strip {
  background: var(--color-surface);
  padding-block: var(--sp-lg);
  text-align: center;
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
}
.welcome-strip .eyebrow { margin-bottom: 0.75rem; }
.welcome-strip h2 {
  font-family: var(--font-heading);
  font-size: clamp(1.8rem, 3.5vw, 2.8rem);
  font-style: italic;
  max-width: 700px;
  margin-inline: auto;
  margin-bottom: 1rem;
}
.welcome-strip p {
  color: var(--color-muted);
  max-width: 560px;
  margin-inline: auto;
  font-size: 1rem;
  line-height: 1.9;
}
.welcome-strip-features {
  display: flex;
  justify-content: center;
  gap: 3rem;
  margin-top: 2.5rem;
  flex-wrap: wrap;
}
.welcome-feature {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
}
.welcome-feature-icon { font-size: 1.5rem; color: var(--color-accent); }
.welcome-feature-label {
  font-size: 0.7rem;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  color: var(--color-muted);
}

@media (max-width: 576px) { .welcome-strip-features { gap: 1.5rem; } }
</style>

<section class="welcome-strip">
  <div class="container container--narrow">
    <p class="eyebrow fade-up">{{ section.settings.eyebrow | default: 'Welcome' }}</p>
    <h2 class="fade-up">{{ section.settings.heading | default: 'Exceptional Food. Memorable Moments.' }}</h2>
    <p class="fade-up">{{ section.settings.description | default: 'Experience thoughtfully prepared food, warm hospitality and unforgettable gatherings at Megan The Restaurant.' }}</p>

    {%- if section.blocks.size > 0 -%}
      <div class="welcome-strip-features">
        {%- for block in section.blocks -%}
          <div class="welcome-feature fade-up" {{ block.shopify_attributes }}>
            <span class="welcome-feature-icon" aria-hidden="true">{{ block.settings.icon | default: '✦' }}</span>
            <span class="welcome-feature-label">{{ block.settings.label }}</span>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Welcome Strip",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Welcome" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Exceptional Food. Memorable Moments." },
    { "type": "text", "id": "description", "label": "Description", "default": "Experience thoughtfully prepared food, warm hospitality and unforgettable gatherings at Megan The Restaurant." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Emoji icon", "default": "🍽" },
        { "type": "text", "id": "label", "label": "Label", "default": "Dine-In" }
      ]
    }
  ],
  "presets": [{
    "name": "Welcome Strip",
    "blocks": [
      { "type": "feature", "settings": { "icon": "🍽", "label": "Dine-In" } },
      { "type": "feature", "settings": { "icon": "🥂", "label": "Private Events" } },
      { "type": "feature", "settings": { "icon": "🎊", "label": "Banquets" } },
      { "type": "feature", "settings": { "icon": "🚗", "label": "Catering" } },
      { "type": "feature", "settings": { "icon": "📅", "label": "Reservations" } }
    ]
  }]
}
{% endschema %}
