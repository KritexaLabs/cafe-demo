<style>
.hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero--full { min-height: 100vh; }
.hero--large { min-height: 85vh; }
.hero--medium { min-height: 70vh; }

.hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hero__bg img, .hero__bg video {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center;
}
.hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: var(--color-bg);
}
.hero__content {
  position: relative;
  z-index: 2;
  padding: 8rem var(--sp-md) var(--sp-lg);
  width: 100%;
  max-width: var(--container);
  margin-inline: auto;
}
.hero__content--center { text-align: center; }
.hero__content--left { text-align: left; }
.hero__content--right { text-align: right; }

.hero__eyebrow {
  font-family: var(--font-body);
  font-size: 0.68rem;
  font-weight: 500;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: var(--color-accent);
  margin-bottom: 1.25rem;
  display: block;
}
.hero__title {
  font-family: var(--font-heading);
  font-size: clamp(3rem, 7vw, 6.5rem);
  font-weight: 300;
  line-height: 1.05;
  color: var(--color-text);
  margin-bottom: 1.25rem;
}
.hero__title em { font-style: italic; color: var(--color-accent); }
.hero__subtitle {
  font-size: clamp(1rem, 1.8vw, 1.2rem);
  color: rgba(240,235,227,0.75);
  max-width: 560px;
  margin-bottom: 2.5rem;
  line-height: 1.8;
}
.hero__content--center .hero__subtitle { margin-inline: auto; }
.hero__actions { display: flex; gap: 1rem; flex-wrap: wrap; }
.hero__content--center .hero__actions { justify-content: center; }

/* Scroll indicator */
.hero__scroll {
  position: absolute;
  bottom: 2rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.5rem;
  color: var(--color-muted);
  font-size: 0.65rem;
  letter-spacing: 0.2em;
  text-transform: uppercase;
}
.hero__scroll-line {
  width: 1px;
  height: 40px;
  background: linear-gradient(to bottom, var(--color-accent), transparent);
  animation: scrollLine 1.8s ease-in-out infinite;
}
@keyframes scrollLine {
  0% { transform: scaleY(0); transform-origin: top; }
  50% { transform: scaleY(1); transform-origin: top; }
  51% { transform: scaleY(1); transform-origin: bottom; }
  100% { transform: scaleY(0); transform-origin: bottom; }
}

@media (max-width: 768px) {
  .hero__content { padding-top: 7rem; }
  .hero__actions { flex-direction: column; align-items: stretch; }
  .hero__actions .btn { text-align: center; justify-content: center; }
  .hero__content--center .hero__actions { align-items: center; }
}
</style>

{%- assign height_class = section.settings.section_height | default: 'full' -%}
{%- assign align_class = section.settings.text_align | default: 'center' -%}

<section class="hero hero--{{ height_class }}" aria-label="Hero">
  <!-- Background -->
  <div class="hero__bg">
    {%- if section.settings.video_url != blank -%}
      <video autoplay muted loop playsinline aria-hidden="true">
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 800 }}">
        {%- endif -%}
        <img
          src="{{ section.settings.image | image_url: width: 1920 }}"
          alt="{{ section.settings.image.alt | default: settings.restaurant_name }}"
          loading="eager"
          fetchpriority="high"
          width="1920"
          height="1080"
        >
      </picture>
    {%- else -%}
      <div style="background: var(--color-surface-2); width:100%; height:100%;"></div>
    {%- endif -%}
  </div>

  <!-- Overlay -->
  <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 10.0 | default: 0.55 }};"></div>

  <!-- Content -->
  <div class="hero__content hero__content--{{ align_class }}">
    {%- if section.settings.eyebrow != blank -%}
      <span class="hero__eyebrow fade-in">{{ section.settings.eyebrow }}</span>
    {%- endif -%}

    <h1 class="hero__title fade-up">
      {{ section.settings.heading | default: settings.restaurant_name | newline_to_br }}
    </h1>

    {%- if section.settings.subheading != blank -%}
      <p class="hero__subtitle fade-up">{{ section.settings.subheading }}</p>
    {%- endif -%}

    <div class="hero__actions fade-up">
      {%- if section.settings.btn_primary_text != blank -%}
        <a href="{{ section.settings.btn_primary_url | default: settings.reservation_url | default: '/pages/reservation' }}" class="btn btn--primary">
          {{ section.settings.btn_primary_text }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn_secondary_text != blank -%}
        <a href="{{ section.settings.btn_secondary_url | default: '/pages/menu' }}" class="btn btn--ghost">
          {{ section.settings.btn_secondary_text }}
        </a>
      {%- endif -%}
    </div>
  </div>

  <div class="hero__scroll" aria-hidden="true">
    <div class="hero__scroll-line"></div>
    <span>Scroll</span>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "text", "id": "video_url", "label": "Video URL (MP4)", "info": "Optional. Overrides image if set." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow text", "default": "Welcome to" },
    { "type": "textarea", "id": "heading", "label": "Heading", "default": "Megan\nThe Restaurant" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Experience thoughtfully prepared food, warm hospitality and unforgettable gatherings." },
    { "type": "text", "id": "btn_primary_text", "label": "Primary button text", "default": "Book a Table" },
    { "type": "url", "id": "btn_primary_url", "label": "Primary button URL" },
    { "type": "text", "id": "btn_secondary_text", "label": "Secondary button text", "default": "Explore Menu" },
    { "type": "url", "id": "btn_secondary_url", "label": "Secondary button URL" },
    { "type": "range", "id": "overlay_opacity", "label": "Overlay opacity", "min": 1, "max": 9, "step": 1, "default": 6 },
    { "type": "select", "id": "text_align", "label": "Text alignment", "options": [{"value":"center","label":"Center"},{"value":"left","label":"Left"},{"value":"right","label":"Right"}], "default": "center" },
    { "type": "select", "id": "section_height", "label": "Section height", "options": [{"value":"full","label":"Full screen"},{"value":"large","label":"Large (85vh)"},{"value":"medium","label":"Medium (70vh)"}], "default": "full" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
