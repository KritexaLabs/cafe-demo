<style>
.hero {
  position: relative;
  width: 100%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.hero--full   { min-height: 100vh; }
.hero--large  { min-height: 85vh; }
.hero--medium { min-height: 65vh; }

.hero__bg {
  position: absolute;
  inset: 0;
  z-index: 0;
}
.hero__bg img,
.hero__bg video {
  width: 100%; height: 100%;
  object-fit: cover;
  object-position: center;
}
.hero__bg-placeholder {
  width: 100%; height: 100%;
  background: var(--color-dark);
}

.hero__overlay {
  position: absolute;
  inset: 0;
  z-index: 1;
  background: var(--color-dark);
}

.hero__content {
  position: relative;
  z-index: 2;
  padding: 9rem var(--sp-md) var(--sp-xl);
  width: 100%;
  max-width: var(--container);
  margin-inline: auto;
}
.hero__content--center { text-align: center; }
.hero__content--left   { text-align: left; }

/* Specialty badge — spaced caps in gold */
.hero__specialty {
  display: inline-block;
  font-family: var(--font-body);
  font-size: 0.6rem;
  font-weight: 600;
  letter-spacing: 0.45em;
  text-transform: uppercase;
  color: var(--color-accent);
  border: 1px solid rgba(197,168,128,0.35);
  padding: 0.45rem 1.2rem;
  margin-bottom: 2rem;
}

/* Restaurant name — large editorial serif */
.hero__name {
  font-family: var(--font-heading);
  font-size: clamp(3.5rem, 9vw, 8rem);
  font-weight: 400;
  line-height: 1;
  color: var(--color-white);
  letter-spacing: -0.01em;
  margin-bottom: 0.5rem;
}

.hero__sub-name {
  font-family: var(--font-body);
  font-size: clamp(0.65rem, 1.2vw, 0.8rem);
  font-weight: 400;
  letter-spacing: 0.45em;
  text-transform: uppercase;
  color: rgba(245,241,234,0.6);
  margin-bottom: 2.5rem;
  display: block;
}

.hero__tagline {
  font-family: var(--font-heading);
  font-size: clamp(1.2rem, 2.5vw, 1.8rem);
  font-style: italic;
  font-weight: 300;
  color: rgba(245,241,234,0.85);
  max-width: 560px;
  line-height: 1.5;
  margin-bottom: 0.75rem;
}
.hero__content--center .hero__tagline { margin-inline: auto; }

.hero__desc {
  font-size: clamp(0.9rem, 1.3vw, 1rem);
  color: rgba(245,241,234,0.55);
  max-width: 480px;
  line-height: 1.9;
  margin-bottom: 2.75rem;
}
.hero__content--center .hero__desc { margin-inline: auto; }

.hero__actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}
.hero__content--center .hero__actions { justify-content: center; }

/* Scroll indicator */
.hero__scroll {
  position: absolute;
  bottom: 2.5rem;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.6rem;
  color: rgba(245,241,234,0.4);
  font-size: 0.6rem;
  letter-spacing: 0.25em;
  text-transform: uppercase;
}
.hero__scroll-line {
  width: 1px;
  height: 48px;
  background: linear-gradient(to bottom, rgba(196,154,98,0.8), transparent);
  animation: scrollPulse 2s ease-in-out infinite;
}
@keyframes scrollPulse {
  0%, 100% { opacity: 0.4; transform: scaleY(0.6); transform-origin: top; }
  50%       { opacity: 1;   transform: scaleY(1);   transform-origin: top; }
}

@media (max-width: 768px) {
  .hero__content { padding-top: 7rem; padding-bottom: var(--sp-lg); }
  .hero__actions { flex-direction: column; align-items: stretch; }
  .hero__actions .btn { text-align: center; justify-content: center; }
  .hero__content--center .hero__actions { align-items: center; }
  .hero__scroll { display: none; }
}
</style>

{%- assign height_class = section.settings.section_height | default: 'full' -%}
{%- assign align_class  = section.settings.text_align    | default: 'center' -%}

<section class="hero hero--{{ height_class }}" aria-label="Hero">

  <div class="hero__bg">
    {%- if section.settings.video_url != blank -%}
      <video autoplay muted loop playsinline aria-hidden="true">
        <source src="{{ section.settings.video_url }}" type="video/mp4">
      </video>
    {%- elsif section.settings.image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source media="(max-width: 768px)" srcset="{{ section.settings.image_mobile | image_url: width: 900 }}">
        {%- endif -%}
        <img
          src="{{ section.settings.image | image_url: width: 2000 }}"
          alt="{{ section.settings.image.alt | default: settings.restaurant_name }}"
          loading="eager"
          fetchpriority="high"
          width="2000"
          height="1125"
        >
      </picture>
    {%- else -%}
      <div class="hero__bg-placeholder"></div>
    {%- endif -%}
  </div>

  <div class="hero__overlay" style="opacity: {{ section.settings.overlay_opacity | divided_by: 10.0 | default: 0.55 }};"></div>

  <div class="hero__content hero__content--{{ align_class }}">

    {%- if section.settings.specialty_badge != blank -%}
      <span class="hero__specialty fade-up">{{ section.settings.specialty_badge }}</span>
    {%- endif -%}

    <h1 class="hero__name fade-up">
      {{ section.settings.heading | default: settings.restaurant_name }}
    </h1>

    {%- if section.settings.sub_name != blank -%}
      <span class="hero__sub-name fade-up">{{ section.settings.sub_name }}</span>
    {%- endif -%}

    {%- if section.settings.tagline != blank -%}
      <p class="hero__tagline fade-up">{{ section.settings.tagline }}</p>
    {%- endif -%}

    {%- if section.settings.description != blank -%}
      <p class="hero__desc fade-up">{{ section.settings.description }}</p>
    {%- endif -%}

    <div class="hero__actions fade-up">
      {%- if section.settings.btn_primary_text != blank -%}
        <a href="{{ section.settings.btn_primary_url | default: settings.reservation_url | default: '/pages/reservation' }}" class="btn btn--accent">
          {{ section.settings.btn_primary_text }}
        </a>
      {%- endif -%}
      {%- if section.settings.btn_secondary_text != blank -%}
        <a href="{{ section.settings.btn_secondary_url | default: '/pages/menu' }}" class="btn btn--outline-light">
          {{ section.settings.btn_secondary_text }}
        </a>
      {%- endif -%}
    </div>

  </div>

  <div class="hero__scroll" aria-hidden="true">
    <div class="hero__scroll-line"></div>
    <span>Scroll</span>
  </div>

</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image",        "label": "Desktop image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image" },
    { "type": "text",         "id": "video_url",    "label": "Video URL (MP4)", "info": "Overrides image if set." },
    { "type": "text",         "id": "specialty_badge", "label": "Specialty badge",  "default": "Italian Specialities" },
    { "type": "textarea",     "id": "heading",          "label": "Main headline",    "default": "Good Food | Good Wine" },
    { "type": "text",         "id": "sub_name",         "label": "Sub-name line",    "default": "The Restaurant" },
    { "type": "text",         "id": "tagline",          "label": "Tagline",          "default": "Country's Most Loved! Serving Since 1978." },
    { "type": "text",         "id": "description",  "label": "Supporting text", "default": "Experience thoughtfully prepared food, warm hospitality and unforgettable gatherings." },
    { "type": "text",         "id": "btn_primary_text",   "label": "Primary button",   "default": "Book a Table" },
    { "type": "url",          "id": "btn_primary_url",    "label": "Primary button URL" },
    { "type": "text",         "id": "btn_secondary_text", "label": "Secondary button", "default": "Explore Menu" },
    { "type": "url",          "id": "btn_secondary_url",  "label": "Secondary button URL" },
    { "type": "range",        "id": "overlay_opacity",    "label": "Overlay opacity", "min": 2, "max": 8, "step": 1, "default": 5 },
    { "type": "select",       "id": "text_align",         "label": "Text alignment", "options": [{"value":"center","label":"Center"},{"value":"left","label":"Left"}], "default": "center" },
    { "type": "select",       "id": "section_height",     "label": "Height", "options": [{"value":"full","label":"Full screen (100vh)"},{"value":"large","label":"Large (85vh)"},{"value":"medium","label":"Medium (65vh)"}], "default": "full" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
