<style>
.contact-section { background: var(--color-surface); }
.contact-layout {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 5rem;
  align-items: start;
}
.contact-info .eyebrow { margin-bottom: 0.75rem; }
.contact-info .section-title { margin-bottom: 1.5rem; }
.contact-info p { color: var(--color-muted); font-size: 0.95rem; line-height: 1.8; margin-bottom: 2rem; }
.contact-detail {
  display: flex;
  gap: 1rem;
  margin-bottom: 1.25rem;
  align-items: flex-start;
}
.contact-detail-icon { color: var(--color-accent); font-size: 1rem; margin-top: 0.1rem; }
.contact-detail-text { font-size: 0.9rem; color: var(--color-muted); line-height: 1.7; }
.contact-detail-text a { color: var(--color-muted); transition: color var(--transition); }
.contact-detail-text a:hover { color: var(--color-accent); }
.contact-form-wrap {
  background: var(--color-bg);
  border: 1px solid var(--color-border);
  border-radius: var(--radius-md);
  padding: 2.5rem;
}
.contact-form-wrap h3 {
  font-family: var(--font-heading);
  font-size: 1.6rem;
  font-style: italic;
  margin-bottom: 1.5rem;
}
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }

@media (max-width: 1024px) { .contact-layout { gap: 3rem; } }
@media (max-width: 768px) {
  .contact-layout { grid-template-columns: 1fr; }
  .form-row { grid-template-columns: 1fr; }
  .contact-form-wrap { padding: 1.5rem; }
}
</style>

<section class="contact-section" id="contact">
  <div class="container">
    <div class="contact-layout">
      <div class="contact-info">
        <p class="eyebrow fade-up">{{ section.settings.eyebrow | default: 'Get in Touch' }}</p>
        <h2 class="section-title fade-up">{{ section.settings.heading | default: 'Contact Us' }}</h2>
        <p class="fade-up">{{ section.settings.description | default: 'We would love to hear from you. Reach out for reservations, events, or any inquiries.' }}</p>

        <div class="contact-detail fade-up">
          <span class="contact-detail-icon" aria-hidden="true">📍</span>
          <div class="contact-detail-text">
            {{ settings.address_line1 }}<br>
            {{ settings.address_line2 }}<br>
            {{ settings.address_country }}
          </div>
        </div>
        {%- if settings.phone != blank -%}
          <div class="contact-detail fade-up">
            <span class="contact-detail-icon" aria-hidden="true">📞</span>
            <div class="contact-detail-text"><a href="tel:{{ settings.phone }}">{{ settings.phone }}</a></div>
          </div>
        {%- endif -%}
        {%- if settings.email != blank -%}
          <div class="contact-detail fade-up">
            <span class="contact-detail-icon" aria-hidden="true">✉</span>
            <div class="contact-detail-text"><a href="mailto:{{ settings.email }}">{{ settings.email }}</a></div>
          </div>
        {%- endif -%}
      </div>

      <div class="contact-form-wrap fade-up" data-validate-wrap>
        <h3>{{ section.settings.form_heading | default: 'Send a Message' }}</h3>
        {%- form 'contact' -%}
            <div class="form-success{% if form.posted_successfully? %} visible{% endif %}">
              Thank you for your message. We will be in touch shortly.
            </div>
            <div class="form-row">
              <div class="form-group">
                <label for="contact-name">Name <span aria-hidden="true">*</span></label>
                <input type="text" id="contact-name" name="contact[name]" required autocomplete="name" placeholder="Your name">
                <p class="form-error" role="alert">Please enter your name.</p>
              </div>
              <div class="form-group">
                <label for="contact-email">Email <span aria-hidden="true">*</span></label>
                <input type="email" id="contact-email" name="contact[email]" required autocomplete="email" placeholder="your@email.com">
                <p class="form-error" role="alert">Please enter a valid email.</p>
              </div>
            </div>
            <div class="form-group">
              <label for="contact-phone">Phone</label>
              <input type="tel" id="contact-phone" name="contact[phone]" autocomplete="tel" placeholder="Your phone number">
            </div>
            <div class="form-group">
              <label for="contact-subject">Subject</label>
              <input type="text" id="contact-subject" name="contact[subject]" placeholder="How can we help?">
            </div>
            <div class="form-group">
              <label for="contact-message">Message <span aria-hidden="true">*</span></label>
              <textarea id="contact-message" name="contact[body]" rows="5" required placeholder="Your message..."></textarea>
              <p class="form-error" role="alert">Please enter your message.</p>
            </div>
            <button type="submit" class="btn btn--primary" style="width:100%;justify-content:center;">
              Send Message
            </button>
          {%- endform -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Contact",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Get in Touch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Contact Us" },
    { "type": "text", "id": "description", "label": "Description", "default": "We would love to hear from you. Reach out for reservations, events, or any inquiries." },
    { "type": "text", "id": "form_heading", "label": "Form heading", "default": "Send a Message" }
  ],
  "presets": [{ "name": "Contact" }]
}
{% endschema %}
